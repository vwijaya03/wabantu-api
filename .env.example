# =====================================================================
# WABantu API — Environment Variables
# Copy to `.env` for local dev. NEVER commit secrets.
# =====================================================================

# ---------- App ----------
NODE_ENV=development
APP_NAME=WABantu API
APP_PORT=3001
APP_URL=http://localhost:3001
# Comma-separated list. Use exact origins (no trailing slash).
CORS_ORIGINS=http://localhost:3000
# Trust proxy hops (e.g. behind nginx / traefik / load balancer)
TRUST_PROXY=0
# Global API prefix; clients call /api/v1/...
API_PREFIX=api
API_VERSION=1

# ---------- Logging ----------
LOG_LEVEL=debug
# pretty | json
LOG_FORMAT=pretty

# ---------- Database: jb_system (master / control plane) ----------
SYSTEM_DB_HOST=localhost
SYSTEM_DB_PORT=5432
SYSTEM_DB_USER=wabantu
SYSTEM_DB_PASSWORD=wabantu_dev_pwd
SYSTEM_DB_NAME=jb_system
SYSTEM_DB_SSL=false
SYSTEM_DB_POOL_MIN=2
SYSTEM_DB_POOL_MAX=10
# Auto-run schema sync in dev only. ALWAYS false in production (use migrations).
SYSTEM_DB_SYNCHRONIZE=true
SYSTEM_DB_LOGGING=false

# ---------- Database: jb_tenant (per-tenant data, schema-per-tenant) ----------
# In single-cluster setup, point this to the same Postgres host.
# In multi-cluster setup, override `host` per tenant via tenant_company.host column.
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=wabantu
TENANT_DB_PASSWORD=wabantu_dev_pwd
TENANT_DB_NAME=jb_tenant
TENANT_DB_SSL=false
TENANT_DB_POOL_MIN=2
TENANT_DB_POOL_MAX=20
TENANT_DB_SYNCHRONIZE=true
TENANT_DB_LOGGING=false
# Prefix prepended to tenant schemas (e.g. `t_<tenant_id_short>`).
TENANT_SCHEMA_PREFIX=t_

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Namespace prefix for all Redis keys
REDIS_KEY_PREFIX=wabantu:
# Use a separate logical DB for BullMQ if you want isolation
BULLMQ_REDIS_DB=1

# ---------- Auth / Sessions ----------
# JWT is signed but the session is also tracked in Redis (server-truth).
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-64-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too-different-from-access
JWT_REFRESH_TTL=30d
# Session inactivity TTL in Redis (sliding expiration). Format: ms-style string.
SESSION_TTL=7d
# bcrypt rounds; 12 is a good balance (cost ~250ms on a typical server).
PASSWORD_HASH_ROUNDS=12

# ---------- Rate limiting ----------
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ---------- WhatsApp (Meta Cloud API) ----------
WHATSAPP_PROVIDER=meta_cloud
META_GRAPH_API_VERSION=v25.0
# Verify token shared between Meta and our webhook
META_WEBHOOK_VERIFY_TOKEN=change-me

# ---------- AI (Anthropic Claude) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=1024

# ---------- Storage (knowledge base uploads) ----------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
# S3 (only used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- Field encryption ----------
# Used to encrypt/decrypt email, name, and businessName at rest in Postgres.
# Generate with: openssl rand -base64 48
DATA_ENCRYPTION_KEY=change-me-random-secret-at-least-32-chars

# Shared secret for internal worker -> API calls (`x-ai-internal-token`)
AI_INTERNAL_TOKEN=change-me-long-random-secret